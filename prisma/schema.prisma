// ============================================================
// PHASE 1 — Centralized Platform: Identity & Organization Layer
// Domain model: Country → State → District → City → Department → Officers
// NOTE: SQLite connector does not support Prisma enums; status/type
// fields are strings validated at the application boundary (Zod)
// and defined once in src/lib/constants.ts. Schema is portable to
// PostgreSQL for later phases (swap datasource provider only).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  states    State[]
}

model State {
  id         String     @id @default(cuid())
  countryId  String
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name       String
  code       String
  status     String     @default("ACTIVE")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  districts  District[]
  cases      Case[]

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId])
}

model District {
  id          String      @id @default(cuid())
  stateId     String
  state       State       @relation(fields: [stateId], references: [id], onDelete: Restrict)
  name        String
  code        String
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cities      City[]
  cases       Case[]

  @@unique([stateId, code])
  @@unique([stateId, name])
  @@index([stateId])
}

model City {
  id          String      @id @default(cuid())
  districtId  String
  district    District    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  name        String
  code        String
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  departments Department[]
  cases       Case[]

  @@unique([districtId, code])
  @@unique([districtId, name])
  @@index([districtId])
}

model Department {
  id             String      @id @default(cuid())
  departmentCode String      @unique
  name           String
  departmentType String
  description    String?
  logoPath       String?
  logoMime       String?
  stateId        String
  districtId     String
  cityId         String
  city           City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  status         String      @default("PENDING")
  officers       Officer[]
  casesAsOrigin      Case[]           @relation("caseOrigin")
  casesAsCustodian   Case[]           @relation("caseCustodian")
  caseParticipations CaseDepartment[]
  caseOfficerRecords CaseOfficer[]
  transfersAsFrom    CaseTransfer[]   @relation("transferFrom")
  transfersAsTo      CaseTransfer[]   @relation("transferTo")
  departmentDocuments CaseDocument[]  @relation("documentUploaderDepartment")
  evidenceCustodianOf     Evidence[]          @relation("evidenceCustodian")
  evidenceCollectedOf     Evidence[]          @relation("evidenceCollectingDept")
  evidenceTransfersFrom   EvidenceTransfer[]  @relation("evidenceTransferFrom")
  evidenceTransfersTo     EvidenceTransfer[]  @relation("evidenceTransferTo")
  aiJobsRequested       AIProcessingJob[] @relation("aiJobRequesterDepartment")
  aiReviewsGiven        AIReview[]        @relation("aiReviewDepartment")
  integrationsOwned     IntegrationConnection[] @relation("integrationOwner")
  // Phase 9 — manual interoperability ownership
  manualExportJobs      ManualExportJob[]   @relation("manualExportDepartment")
  manualImportJobs      ManualImportJob[]   @relation("manualImportDepartment")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([stateId])
  @@index([districtId])
  @@index([cityId])
  @@index([departmentType])
  @@index([status])
}

model Officer {
  id                   String    @id @default(cuid())
  officerId            String    @unique
  departmentId         String
  department           Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name                 String
  email                String    @unique
  phone                String?
  designation          String
  role                 String
  status               String    @default("PENDING")
  passwordHash         String
  authenticationStatus String    @default("PASSWORD")
  lastLoginAt          DateTime?
  sessions             Session[]
  casesAsCustodianOfficer Case[]         @relation("caseCustodianOfficer")
  casesCreated            Case[]         @relation("caseCreatedBy")
  caseOfficerRecords      CaseOfficer[]
  transfersFromOfficer    CaseTransfer[] @relation("transferFromOfficer")
  transfersToOfficer      CaseTransfer[] @relation("transferToOfficer")
  transfersRequestedBy    CaseTransfer[] @relation("transferRequestedBy")
  transfersAcceptedBy     CaseTransfer[] @relation("transferAcceptedBy")
  documentsUploaded       CaseDocument[] @relation("documentUploader")
  documentRelCreators     DocumentRelationship[]  @relation("documentRelationshipCreator")
  documentUploadSessions  DocumentUploadSession[] @relation("documentUploadSessionActor")
  evidenceCollected        Evidence[]                     @relation("evidenceCollector")
  evidenceRegistered       Evidence[]                     @relation("evidenceRegistrar")
  evidenceCustodianOf      Evidence[]                     @relation("evidenceCustodianOfficer")
  evidenceTransfersRequestedBy EvidenceTransfer[]         @relation("evidenceTransferRequestedBy")
  evidenceTransfersAcceptedBy  EvidenceTransfer[]         @relation("evidenceTransferAcceptedBy")
  evidenceTransfersFromOfficer EvidenceTransfer[]         @relation("evidenceTransferFromOfficer")
  evidenceTransfersToOfficer   EvidenceTransfer[]         @relation("evidenceTransferToOfficer")
  evidenceRelCreators      EvidenceDocumentRelationship[] @relation("evidenceRelationshipCreator")
  auditEventsActed         AuditEvent[]                   @relation("auditEventActor")
  aiJobsRequested          AIProcessingJob[]              @relation("aiJobRequester")
  aiClassificationsReviewed AIDocumentClassification[]    @relation("aiClassificationReviewer")
  aiEntityMatchesReviewed  EntityCandidateMatch[]         @relation("entityMatchReviewer")
  aiRelationshipsReviewed  AIRelationshipSuggestion[]     @relation("aiRelationshipReviewer")
  aiReviewsGiven           AIReview[]                     @relation("aiReviewReviewer")
  integrationsCreated      IntegrationConnection[]        @relation("integrationCreator")
  integrationsImportedBy   IntegrationImportJob[]         @relation("integrationImporter")
  integrationsExportedBy   IntegrationExportJob[]         @relation("integrationExporter")
  integrationConflictsResolved IntegrationConflict[]     @relation("integrationConflictResolver")
  // Phase 9 — manual interoperability roles
  manualExportJobs         ManualExportJob[]              @relation("manualExporter")
  manualImportJobs         ManualImportJob[]              @relation("manualImporter")
  manualConflictsResolved  ManualImportConflict[]         @relation("manualConflictResolver")
  importApprovalsGiven     ImportApproval[]               @relation("importApprover")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([departmentId])
  @@index([role])
  @@index([status])
}

model Session {
  id            String    @id
  officerId     String
  officer       Officer   @relation(fields: [officerId], references: [id], onDelete: Cascade)
  departmentId  String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastActivity  DateTime  @default(now())
  revoked       Boolean   @default(false)
  revokedAt     DateTime?
  userAgent     String?
  ipAddress     String?

  @@index([officerId])
  @@index([departmentId])
}

model IdentityEvent {
  id               String   @id @default(cuid())
  eventType        String
  actorOfficerId   String?
  actorIdentifier  String?
  departmentId     String?
  targetType       String?
  targetId         String?
  metadata         String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([eventType])
  @@index([actorOfficerId])
  @@index([departmentId])
  @@index([createdAt])
}

// ============================================================
// PHASE 2 — Case Management & Custody (spec §4/§12/§13/§19/§24)
// The CASE is the central entity of the platform. Status/type
// fields are strings validated at the application boundary
// (Zod) and defined once in src/lib/constants.ts — SQLite has
// no enums; schema stays PostgreSQL-portable.
// Historical records (custody, participation, timeline) are
// NEVER cascade-deleted (spec §35/§36): Restrict everywhere.
// ============================================================

model Case {
  id                            String    @id @default(cuid())
  caseId                        String    @unique // public identity: CASE-MP-IND-2026-000001
  caseNumber                    String?   // official reference: FIR/124/2026 (uniqueness scoped per originating dept + format)
  title                         String
  description                   String?
  caseType                      String
  caseCategory                  String?
  priority                      String    @default("NORMAL")
  status                        String    @default("DRAFT")

  stateId                       String
  state                         State     @relation(fields: [stateId], references: [id], onDelete: Restrict)
  districtId                    String
  district                      District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  cityId                        String
  city                          City      @relation(fields: [cityId], references: [id], onDelete: Restrict)

  originatingDepartmentId       String
  originatingDepartment         Department @relation("caseOrigin", fields: [originatingDepartmentId], references: [id], onDelete: Restrict)
  currentCustodianDepartmentId  String
  currentCustodianDepartment    Department @relation("caseCustodian", fields: [currentCustodianDepartmentId], references: [id], onDelete: Restrict)
  currentCustodianOfficerId     String?
  currentCustodianOfficer       Officer?  @relation("caseCustodianOfficer", fields: [currentCustodianOfficerId], references: [id], onDelete: SetNull)

  createdByOfficerId            String
  createdByOfficer              Officer   @relation("caseCreatedBy", fields: [createdByOfficerId], references: [id], onDelete: Restrict)
  createdByDepartmentId         String

  openedAt                      DateTime?
  closedAt                      DateTime?
  archivedAt                    DateTime?
  version                       Int       @default(1) // optimistic concurrency for custody (spec §47)

  departments                   CaseDepartment[]
  officers                      CaseOfficer[]
  transfers                     CaseTransfer[]
  events                        CaseEvent[]
  documents                     CaseDocument[]
  documentUploadSessions        DocumentUploadSession[]
  evidence                      Evidence[]
  evidenceTransfers             EvidenceTransfer[]
  aiJobs                        AIProcessingJob[]  @relation("aiJobCase")
  aiTimelineEvents              AITimelineEvent[]  @relation("caseAiTimeline")
  externalCaseReferences        ExternalCaseReference[]
  graphSync                     GraphSyncState?    @relation("caseGraphSync")

  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([caseId])
  @@index([caseNumber])
  @@index([status])
  @@index([caseType])
  @@index([priority])
  @@index([originatingDepartmentId])
  @@index([currentCustodianDepartmentId])
  @@index([createdByDepartmentId])
  @@index([stateId])
  @@index([districtId])
  @@index([cityId])
  @@index([createdAt])
}

model CaseDepartment {
  id                String    @id @default(cuid())
  caseId            String
  case              Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  participationType String    // ORIGINATING | ACTIVE_CUSTODIAN | PARTICIPATING | CONSULTED | HISTORICAL
  status            String    @default("ACTIVE") // ACTIVE | REMOVED
  joinedAt          DateTime  @default(now())
  leftAt            DateTime?
  addedByOfficerId  String?
  note              String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([caseId, departmentId])
  @@index([caseId])
  @@index([departmentId])
  @@index([participationType])
  @@index([status])
}

model CaseOfficer {
  id                 String    @id @default(cuid())
  caseId             String
  case               Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  officerId          String
  officer            Officer   @relation(fields: [officerId], references: [id], onDelete: Restrict)
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  roleOnCase         String
  status             String    @default("ACTIVE") // ACTIVE | REMOVED
  assignedAt         DateTime  @default(now())
  unassignedAt       DateTime?
  assignedByOfficerId String?
  note               String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([caseId, officerId])
  @@index([caseId])
  @@index([officerId])
  @@index([departmentId])
  @@index([status])
}

model CaseTransfer {
  id                  String    @id @default(cuid())
  transferId          String    @unique // TRF-MP-IND-2026-000001
  caseId              String
  case                Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)

  fromDepartmentId    String
  fromDepartment      Department @relation("transferFrom", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartmentId      String
  toDepartment        Department @relation("transferTo", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  fromOfficerId       String?
  fromOfficer         Officer?  @relation("transferFromOfficer", fields: [fromOfficerId], references: [id], onDelete: SetNull)
  toOfficerId         String?
  toOfficer           Officer?  @relation("transferToOfficer", fields: [toOfficerId], references: [id], onDelete: SetNull)
  requestedByOfficerId String
  requestedByOfficer  Officer   @relation("transferRequestedBy", fields: [requestedByOfficerId], references: [id], onDelete: Restrict)
  acceptedByOfficerId String?
  acceptedByOfficer   Officer?  @relation("transferAcceptedBy", fields: [acceptedByOfficerId], references: [id], onDelete: SetNull)

  status              String    @default("REQUESTED") // REQUESTED | ACCEPTED | REJECTED | CANCELLED | EXPIRED
  reason              String
  transferNotes       String?

  requestedAt         DateTime  @default(now())
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  cancelledAt         DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([toDepartmentId])
  @@index([fromDepartmentId])
}

model CaseEvent {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  eventType       String
  actorOfficerId  String?
  actorIdentifier String?
  departmentId    String?
  targetType      String?
  targetId        String?
  description     String?
  metadata        String?
  createdAt       DateTime @default(now())

  @@index([caseId])
  @@index([caseId, createdAt])
  @@index([eventType])
  @@index([departmentId])
}

// ============================================================
// PHASE 3 — Secure Digital Document Management (spec §5/§9/§50/§51).
//
// IMMUTABILITY MODEL (spec §2/§35): a COMMITTED CaseDocument row is
// a legal record. After commit, documentId, caseId, binary content,
// sha256Hash, originalFilename, mimeType, fileSize, storageKey,
// uploadedBy identity and committedAt are FROZEN — no API mutates
// them, and documents are never hard-deleted. Corrections and
// supplements are NEW immutable rows linked through
// DocumentRelationship; replacement flips the original to
// SUPERSEDED (a status, never a deletion).
//
// TWO-PHASE COMMIT (spec §12/§22/§23): the binary is validated,
// hashed (SHA-256 over plaintext), encrypted (AES-256-GCM) and
// stored BEFORE metadata persists. A Document row exists only from
// commit onward; failures are tracked on DocumentUploadSession and
// staged objects are cleaned up or quarantined — a failed upload
// can never appear as a valid document.
//
// STORAGE: files live OUTSIDE /public under opaque server-generated
// keys (cases/{case-uuid}/documents/{uuid}/object); the original
// filename is metadata only. SQLite keeps metadata only.
// ============================================================

model CaseDocument {
  id                     String    @id @default(cuid()) // internal id — never exposed as storage path
  documentId             String    @unique // public identity: DOC-MP-IND-2026-000001 (backend-generated, immutable)
  caseId                 String
  case                   Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)

  // classification
  title                  String
  description            String?
  documentType           String    // DOCUMENT_TYPES registry
  documentCategory       String?   // DOCUMENT_CATEGORIES registry

  // file facts — frozen after commit (spec §35)
  originalFilename       String    // preserved as metadata only, never a storage path
  storedFilename         String    // server-generated <uuid>.bin
  mimeType               String    // server-detected via magic bytes
  fileExtension          String
  fileSize               Int
  storageProvider        String    // STORAGE_PROVIDERS registry
  storageKey             String    // opaque: cases/{case-uuid}/documents/{uuid}/object
  sha256Hash             String    // integrity fingerprint over PLAINTEXT, computed pre-encryption
  encryptionStatus       String    // ENCRYPTION_STATUSES registry
  keyReference           String?   // key VERSION reference — never the key material

  // lifecycle & security
  status                 String    @default("COMMITTED") // DOCUMENT_STATUSES
  classification         String    // DOCUMENT_CLASSIFICATIONS

  // origin — frozen after commit; always derived server-side
  uploadedByOfficerId    String
  uploadedByOfficer      Officer   @relation("documentUploader", fields: [uploadedByOfficerId], references: [id], onDelete: Restrict)
  uploadedByDepartmentId String
  uploadedByDepartment   Department @relation("documentUploaderDepartment", fields: [uploadedByDepartmentId], references: [id], onDelete: Restrict)

  // dates are distinct (spec §28): documentDate is the business date,
  // createdAt is upload time, committedAt is commit time.
  documentDate           DateTime?
  metadata               String?   // validated JSON block (referenceNumber, issuingDepartmentName, externalReference, tags)

  committedAt            DateTime?
  supersededByDocumentId String?   // public id of the designated successor (replacement workflow)
  uploadSessionId        String?   @unique

  relationshipsAsSource DocumentRelationship[] @relation("docRelationshipSource")
  relationshipsAsTarget DocumentRelationship[] @relation("docRelationshipTarget")
  evidenceRelationships EvidenceDocumentRelationship[] @relation("evidenceRelationshipDocument")
  events                DocumentEvent[]

  createdAt              DateTime  @default(now()) // uploaded at
  updatedAt              DateTime  @updatedAt

  @@index([caseId])
  @@index([caseId, status])
  @@index([documentType])
  @@index([classification])
  @@index([status])
  @@index([uploadedByOfficerId])
  @@index([uploadedByDepartmentId])
  @@index([createdAt])
  @@index([sha256Hash]) // duplicate awareness (spec §66/§67) — hash is NOT a business identifier

  // Phase 5 AI-derived data (spec §50) — every relation below is DERIVED; originals stay untouched
  aiJobs              AIProcessingJob[]          @relation("aiJobDocument")
  texts               DocumentText[]             @relation("documentText")
  ocrResults          OcrResult[]                @relation("documentOcr")
  aiClassifications   AIDocumentClassification[] @relation("documentAiClassification")
  entities            ExtractedEntity[]          @relation("documentEntity")
  aiSummaries         AIDocumentSummary[]        @relation("documentAiSummary")
  aiTimelineEvents    AITimelineEvent[]          @relation("documentAiTimeline")
  chunks              DocumentChunk[]            @relation("documentChunk")
  embeddings          DocumentEmbedding[]        @relation("documentEmbedding")
  aiRelSuggestionsAsSource AIRelationshipSuggestion[] @relation("aiRelSource")
  aiRelSuggestionsAsTarget AIRelationshipSuggestion[] @relation("aiRelTarget")
  externalDocumentReferences ExternalDocumentReference[]
}

model DocumentRelationship {
  id                 String       @id @default(cuid())
  sourceDocumentId   String       // the NEW/related document (e.g. the supplement)
  sourceDocument     CaseDocument @relation("docRelationshipSource", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  targetDocumentId   String       // the document it relates to (e.g. the original)
  targetDocument     CaseDocument @relation("docRelationshipTarget", fields: [targetDocumentId], references: [id], onDelete: Restrict)
  relationshipType   String       // DOCUMENT_RELATIONSHIP_TYPES
  createdByOfficerId String
  createdByOfficer   Officer      @relation("documentRelationshipCreator", fields: [createdByOfficerId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())

  @@unique([sourceDocumentId, targetDocumentId, relationshipType])
  @@index([sourceDocumentId])
  @@index([targetDocumentId])
  @@index([relationshipType])
}

// Audit event interface (spec §51/§52). Phase 4's immutable ledger
// consumes these; sensitive content (passwords, keys, contents) is
// never written into metadata.
model DocumentEvent {
  id             String        @id @default(cuid())
  documentId     String?
  document       CaseDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  caseId         String
  eventType      String        // DOCUMENT_EVENT_TYPES
  actorOfficerId String?
  departmentId   String?
  sessionId      String?
  result         String?       // SUCCESS | DENIED | FAILED | MATCH | MISMATCH
  metadata       String?
  createdAt      DateTime      @default(now())

  @@index([documentId])
  @@index([caseId])
  @@index([eventType])
  @@index([actorOfficerId])
  @@index([createdAt])
}

// Two-phase upload state (spec §12/§22/§68/§69). The session is the
// reconciliation record: staged objects referenced only by non-
// COMMITTED sessions are orphan cleanup candidates.
model DocumentUploadSession {
  id                  String   @id @default(uuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  clientRequestId     String?  // idempotency key (spec §68)
  status              String   @default("UPLOADING") // UPLOAD_SESSION_STATUSES
  originalFilename    String?
  declaredMimeType    String?
  fileSize            Int?
  storageKey          String?  // staged object (cleanup/reconciliation)
  errorMessage        String?
  createdDocumentId   String?  // public DOC id once committed
  uploadedByOfficerId String
  uploadedByOfficer   Officer  @relation("documentUploadSessionActor", fields: [uploadedByOfficerId], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([uploadedByOfficerId, clientRequestId])
  @@index([caseId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// PHASE 4 — Evidence & chain of custody (spec §3/§5/§15/§16).
//
// EVIDENCE ≠ DOCUMENT (spec §3/§46): a document describes
// something; evidence IS the item being handled (device, sample,
// recording, artifact). Both hang off the CASE.
//
// IMMUTABILITY MODEL: after commit, sha256Hash, hashAlgorithm,
// storageKey, storageProvider and the custody HISTORY are frozen —
// no API mutates them and evidence is never hard-deleted.
// Custody changes flow ONLY through EvidenceCustodyService
// (transfer request → accept → custody swap + events in ONE
// transaction); controllers never touch currentCustodian* fields
// (spec §17). Evidence custody is INDEPENDENT of case custody
// (spec §45) — transferring a case never moves its evidence.
//
// PHYSICAL vs DIGITAL (spec §11): physical evidence has no binary
// (hasDigitalContent=false, storage fields null). Digital evidence
// follows the Phase 3 two-phase pipeline: validate → scan →
// SHA-256 (plaintext) → AES-256-GCM encrypt → store via the SAME
// DocumentStorage abstraction (spec §12) → commit row + custody +
// audit atomically.
// ============================================================

model Evidence {
  id                          String    @id @default(cuid())
  evidenceId                  String    @unique // public identity: EVD-MP-IND-2026-000001 (backend-generated, immutable)
  caseId                      String
  case                        Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)

  // descriptive metadata
  evidenceNumber              String?   // external reference (seizure memo no., exhibit tag) — never the system identity
  title                       String
  description                 String?
  evidenceType                String    // EVIDENCE_TYPES registry (spec §6)
  category                    String?   // free-text subcategory (extensible, spec §6)
  status                      String    @default("REGISTERED") // EVIDENCE_STATUSES (spec §8), transitions controlled
  classification              String    // EVIDENCE_CLASSIFICATIONS (spec §9) — drives authorization

  // acquisition (spec §10)
  sourceType                  String    // EVIDENCE_SOURCE_TYPES registry (spec §7)
  sourceReference             String?
  collectionLocation          String?
  collectedAt                 DateTime?
  receivedAt                  DateTime?
  condition                   String?
  notes                       String?
  deviceMetadata              String?   // optional JSON (manufacturer/model/serial/gps) — NOT claimed available for every type

  collectedByOfficerId        String?
  collectedByOfficer          Officer?  @relation("evidenceCollector", fields: [collectedByOfficerId], references: [id], onDelete: SetNull)
  collectingDepartmentId      String
  collectingDepartment        Department @relation("evidenceCollectingDept", fields: [collectingDepartmentId], references: [id], onDelete: Restrict)

  // custody — maintained ONLY by EvidenceCustodyService (spec §17)
  currentCustodianDepartmentId String?
  currentCustodianDepartment  Department? @relation("evidenceCustodian", fields: [currentCustodianDepartmentId], references: [id], onDelete: SetNull)
  currentCustodianOfficerId   String?
  currentCustodianOfficer     Officer?  @relation("evidenceCustodianOfficer", fields: [currentCustodianOfficerId], references: [id], onDelete: SetNull)

  // digital content (spec §11/§13/§14) — frozen after commit
  hasDigitalContent           Boolean   @default(false)
  originalFilename            String?   // metadata only, never a storage path
  mimeType                    String?   // server-detected via magic bytes
  fileSize                    Int?
  storageProvider             String?   // STORAGE_PROVIDERS registry
  storageKey                  String?   // opaque: evidence/{case-uuid}/{uuid}/object — NEVER exposed to clients (spec §5)
  sha256Hash                  String?   // integrity fingerprint over PLAINTEXT, pre-encryption
  hashAlgorithm               String    @default("SHA-256") // stored explicitly (spec §14) — architecture allows evolution
  encryptionStatus            String?
  keyReference                String?   // non-secret key version label

  // origin — derived server-side, frozen after commit
  registeredByOfficerId       String
  registeredByOfficer         Officer   @relation("evidenceRegistrar", fields: [registeredByOfficerId], references: [id], onDelete: Restrict)
  registeredByDepartmentId    String

  version                     Int       @default(1) // optimistic concurrency for custody swaps
  committedAt                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  transfers                   EvidenceTransfer[]
  documentRelationships       EvidenceDocumentRelationship[]
  externalEvidenceReferences  ExternalEvidenceReference[]

  @@index([caseId])
  @@index([caseId, status])
  @@index([evidenceType])
  @@index([status])
  @@index([classification])
  @@index([currentCustodianDepartmentId])
  @@index([collectingDepartmentId])
  @@index([registeredByOfficerId])
  @@index([registeredByDepartmentId])
  @@index([sha256Hash]) // duplicate awareness — NOT a business identifier
  @@index([createdAt])
}

// Custody transfer record (spec §16). REQUESTED → ACCEPTED is the
// only path that changes current custody; REJECTED/CANCELLED leave
// it untouched (spec §17/§44). Decided transfers are HISTORICAL —
// they can never be edited or deleted (SQLite guards + no API).
model EvidenceTransfer {
  id                    String    @id @default(cuid())
  transferId            String    @unique // public identity: ETR-MP-IND-2026-000001
  evidenceId            String    // internal Evidence.id
  evidence              Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  caseId                String
  case                  Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)

  fromDepartmentId      String
  fromDepartment        Department @relation("evidenceTransferFrom", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartmentId        String
  toDepartment          Department @relation("evidenceTransferTo", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  fromOfficerId         String?   // releasing officer
  fromOfficer           Officer?  @relation("evidenceTransferFromOfficer", fields: [fromOfficerId], references: [id], onDelete: SetNull)
  toOfficerId           String?   // receiving officer
  toOfficer             Officer?  @relation("evidenceTransferToOfficer", fields: [toOfficerId], references: [id], onDelete: SetNull)
  requestedByOfficerId  String
  requestedByOfficer    Officer   @relation("evidenceTransferRequestedBy", fields: [requestedByOfficerId], references: [id], onDelete: Restrict)
  acceptedByOfficerId   String?
  acceptedByOfficer     Officer?  @relation("evidenceTransferAcceptedBy", fields: [acceptedByOfficerId], references: [id], onDelete: SetNull)

  status                String    @default("REQUESTED") // REQUESTED | ACCEPTED | REJECTED | CANCELLED
  reason                String
  notes                 String?
  previousItemStatus    String?   // evidence status before TRANSFER_PENDING — restored on reject/cancel

  requestedAt           DateTime  @default(now())
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([evidenceId])
  @@index([evidenceId, status])
  @@index([caseId])
  @@index([status])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([requestedAt])
}

// Evidence ↔ Document relationships (spec §20). Direction is
// DOCUMENT → EVIDENCE: a forensic report DESCRIBES / RESULTS_FROM /
// DERIVED_FROM the evidence; SUPPORTS and RELATED are symmetric.
// This is deliberately NOT a knowledge graph (spec §20/§68).
model EvidenceDocumentRelationship {
  id                 String       @id @default(cuid())
  evidenceId         String       // internal Evidence.id
  evidence           Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  documentId         String       // internal CaseDocument.id
  document           CaseDocument @relation("evidenceRelationshipDocument", fields: [documentId], references: [id], onDelete: Restrict)
  relationshipType   String       // EVIDENCE_RELATIONSHIP_TYPES (spec §20)
  note               String?
  createdByOfficerId String
  createdByOfficer   Officer      @relation("evidenceRelationshipCreator", fields: [createdByOfficerId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())

  @@unique([evidenceId, documentId, relationshipType])
  @@index([evidenceId])
  @@index([documentId])
  @@index([relationshipType])
}

// ============================================================
// PHASE 4 — Immutable audit architecture (spec §22-§31/§48-§55).
//
// APPEND-ONLY: no API ever updates or deletes an AuditEvent; the
// SQLite layer additionally enforces this with RAISE(ABORT)
// triggers (spec §58 — applied by scripts/apply-sqlite-guards.ts).
// Corrections are NEW events, never edits (spec §24).
//
// HASH CHAIN (spec §25/§26): event_hash = SHA-256(canonical payload
// + previous_event_hash); canonical serialization is ONE shared
// implementation (CanonicalAuditSerializer, spec §55) — field
// order fixed, metadata keys sorted, timestamps ISO-UTC. The chain
// starts at the documented AUDIT_GENESIS hash (spec §27).
//
// caseId/documentId/evidenceId store PUBLIC identifiers WITHOUT
// foreign keys by design: audit records are self-contained, they
// outlive resource lifecycles, and the ledger must never be
// blocked by (or cascade from) resource management. Actor fields
// ARE foreign keys with Restrict — audit presence prevents
// destroying actor identity.
//
// HONEST BOUNDARY (spec §29): a database hash chain is
// tamper-EVIDENT against application-level and casual DB tampering;
// it does NOT stop a privileged infrastructure administrator who
// can rewrite the whole table and every hash. External anchoring
// via LedgerAnchor (spec §30/§31) is the production extension.
// ============================================================

model AuditEvent {
  id                String    @id @default(cuid())
  sequence          Int       @unique // chain position, monotonic, gap-free (spec §53/§54)
  eventId           String    @unique // public identity: EVT-2026-000001
  eventType         String    // AUDIT_EVENT_TYPES registry (spec §21/§22)

  actorOfficerId    String?
  actorOfficer      Officer?  @relation("auditEventActor", fields: [actorOfficerId], references: [id], onDelete: Restrict)
  actorIdentifier   String?   // attempted identity for events with no resolved actor (failed logins)
  actorDepartmentId String?

  caseId            String?   // PUBLIC id (CASE-…), no FK — self-contained ledger
  documentId        String?   // PUBLIC id (DOC-…)
  evidenceId        String?   // PUBLIC id (EVD-…)

  sessionId         String?
  timestamp         DateTime  @default(now()) // event occurrence time (service-stamped)
  result            String    @default("SUCCESS") // SUCCESS | DENIED | FAILED
  ipAddress         String?
  deviceId          String?
  userAgent         String?
  metadata          String?   // sanitized JSON — never secrets/contents (spec §23/§50)

  previousEventHash String    // GENESIS hash for sequence 1 (spec §27)
  eventHash         String    // SHA-256(canonical payload incl. previous hash)
  ledgerStatus      String    @default("UNANCHORED") // UNANCHORED | ANCHORED (spec §23/§31)

  createdAt         DateTime  @default(now())

  @@index([sequence])
  @@index([eventType])
  @@index([actorOfficerId])
  @@index([actorDepartmentId])
  @@index([caseId])
  @@index([documentId])
  @@index([evidenceId])
  @@index([timestamp])
  @@index([result])
  @@index([sessionId])
}

// Persisted chain state (spec §53) — the ONLY mutable row in the
// audit architecture; kept in the same transaction as every append
// so concurrent writers serialize correctly. Verification results
// are cached here for the integrity dashboard (spec §61).
model AuditChainState {
  id                   String    @id @default("SINGLETON")
  lastSequence         Int       @default(0)
  lastEventHash        String    @default("") // equals AUDIT_GENESIS_HASH before the first event
  lastEventId          String?
  eventCount           Int       @default(0)
  lastVerifiedAt       DateTime?
  lastVerifiedResult   String?   // VALID | INVALID
  lastVerifiedSequence Int?
  lastInvalidSequence  Int?
  updatedAt            DateTime  @updatedAt
}

// Ledger anchor (spec §30/§31/§67): a periodic commitment of the
// chain head produced by a LedgerAdapter. MVP adapter = DATABASE
// (self-verifying); Hyperledger Fabric adapter is an interface
// stub for a future phase — never claimed as live (spec §31/§68).
model LedgerAnchor {
  id                  String   @id @default(cuid())
  anchorId            String   @unique // public identity: ANCHOR-2026-000001
  provider            String   // LedgerAdapters registry: DATABASE (live) | HYPERLEDGER_FABRIC (stub only)
  chainHash           String   // chain head hash at anchor time
  upToSequence        Int
  eventCount          Int
  anchoredByOfficerId String?
  externalReference   String?  // provider transaction/reference (future external ledgers)
  anchoredAt          DateTime @default(now())

  @@index([provider])
  @@index([anchoredAt])
}

// ============================================================
// PHASE 5 — AI Document Intelligence (spec §5/§28/§39/§50).
//
// DERIVED-DATA PRINCIPLE (spec §2): every AI_* / Ocr* / DocumentText /
// DocumentChunk / DocumentEmbedding row is AI-DERIVED data. It never
// overwrites authoritative records (CaseDocument type/status, Evidence
// custody, official CaseEvent timeline). Human review is tracked on
// each result via reviewStatus; reviewer identity always comes from
// the authenticated session (spec §30), never from the client.
//
// PROVENANCE (spec §40): results carry modelProvider/modelName/
// modelVersion + jobId + source references so any result can be
// traced to document → page → source text.
// ============================================================

model AIProcessingJob {
  id                      String    @id @default(cuid())
  jobId                   String    @unique // public identity: AIJ-2026-000001
  documentId              String?   // null for case-wide jobs (CASE_SUMMARY etc.)
  document                CaseDocument? @relation("aiJobDocument", fields: [documentId], references: [id], onDelete: Restrict)
  documentRef             String?   // public DOC id (denormalized for display)
  caseId                  String
  case                    Case      @relation("aiJobCase", fields: [caseId], references: [id], onDelete: Restrict)
  caseRef                 String    // public CASE id
  requestedByOfficerId    String
  requestedByOfficer      Officer   @relation("aiJobRequester", fields: [requestedByOfficerId], references: [id], onDelete: Restrict)
  requestedByDepartmentId String
  requestedByDepartment   Department @relation("aiJobRequesterDepartment", fields: [requestedByDepartmentId], references: [id], onDelete: Restrict)
  jobType                 String    // AI_JOB_TYPES
  status                  String    @default("QUEUED") // AI_JOB_STATUSES
  priority                String    @default("NORMAL") // AI_JOB_PRIORITIES
  stage                   String?   // human-readable current pipeline stage
  modelProvider           String?
  modelName               String?
  modelVersion            String?
  startedAt               DateTime?
  completedAt             DateTime?
  errorCode               String?   // safe machine code — never an exception trace (spec §5)
  errorMessage            String?   // safe user-facing message
  resultSummary           String?   // JSON: produced artifact references/counts
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([documentId])
  @@index([caseId])
  @@index([caseRef])
  @@index([status])
  @@index([jobType])
  @@index([requestedByOfficerId])
  @@index([createdAt])
}

// Normalized text (spec §9): the analysis input. One current row per
// page; MANUAL_CORRECTION supersedes the previous value, which is
// snapshotted into AIResultVersion before the update (spec §41/§29).
model DocumentText {
  id                   String   @id @default(cuid())
  documentId           String
  document             CaseDocument @relation("documentText", fields: [documentId], references: [id], onDelete: Restrict)
  pageNumber           Int      // 0 = document-level (formats without pages)
  sectionIdentifier    String?
  text                 String
  language             String?  // EN | HI | MIXED | LOW_CONFIDENCE variants
  languageConfidence   Float?
  sourceType           String   // TEXT_SOURCE_TYPES: NATIVE_TEXT | OCR | MANUAL_CORRECTION
  sourceReference      String?  // extractor/provider/officer provenance string
  extractionConfidence Float?
  jobId                String?  // AIJ- reference of the producing job
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

// Raw OCR output per page (spec §7): DERIVED, never replaces the file.
model OcrResult {
  id             String   @id @default(cuid())
  documentId     String
  document       CaseDocument @relation("documentOcr", fields: [documentId], references: [id], onDelete: Restrict)
  pageNumber     Int
  recognizedText String
  language       String?
  confidence     Float?
  boundingBoxes  String?  // JSON (provider-dependent; may be absent)
  provider       String
  modelVersion   String?
  jobId          String?
  createdAt      DateTime @default(now())

  @@unique([documentId, pageNumber, provider])
  @@index([documentId])
}

model AIDocumentClassification {
  id                  String    @id @default(cuid())
  documentId          String
  document            CaseDocument @relation("documentAiClassification", fields: [documentId], references: [id], onDelete: Restrict)
  caseRef             String    // public CASE id
  suggestedType       String    // a DOCUMENT_TYPES value — SUGGESTION ONLY (spec §10)
  suggestedCategory   String?
  confidence          Float
  reason              String?
  sourceReference     String?
  modelProvider       String
  modelName           String
  modelVersion        String?
  reviewStatus        String    @default("PENDING") // PENDING|ACCEPTED|REJECTED|OVERRIDDEN
  overrideType        String?   // human-corrected type when OVERRIDDEN (recorded on the suggestion — the authoritative document type is NEVER changed by AI or review)
  reviewedByOfficerId String?
  reviewedByOfficer   Officer?  @relation("aiClassificationReviewer", fields: [reviewedByOfficerId], references: [id], onDelete: Restrict)
  reviewedAt          DateTime?
  jobId               String?
  createdAt           DateTime  @default(now())

  @@index([documentId])
  @@index([reviewStatus])
}

model ExtractedEntity {
  id              String   @id @default(cuid())
  documentId      String
  document        CaseDocument @relation("documentEntity", fields: [documentId], references: [id], onDelete: Restrict)
  caseRef         String   // public CASE id
  entityType      String   // AI_ENTITY_TYPES
  originalText    String
  normalizedValue String?
  pageNumber      Int
  startOffset     Int?
  endOffset       Int?
  confidence      Float
  sourceReference String?  // resolvable: "DOC-…|page 3|offset 120"
  modelProvider   String
  modelName       String
  modelVersion    String?
  reviewStatus    String   @default("PENDING") // PENDING|VERIFIED|REJECTED|OVERRIDDEN
  reviewedByOfficerId String?
  reviewedAt      DateTime?
  jobId           String?
  createdAt       DateTime @default(now())

  @@index([documentId])
  @@index([caseRef])
  @@index([entityType])
  @@index([reviewStatus])

  matchesAsA EntityCandidateMatch[] @relation("entityMatchA")
  matchesAsB EntityCandidateMatch[] @relation("entityMatchB")
}

// Candidate similarity only — NEVER an automatic merge (spec §13).
model EntityCandidateMatch {
  id                  String   @id @default(cuid())
  entityAId           String
  entityA             ExtractedEntity @relation("entityMatchA", fields: [entityAId], references: [id], onDelete: Restrict)
  entityBId           String
  entityB             ExtractedEntity @relation("entityMatchB", fields: [entityBId], references: [id], onDelete: Restrict)
  similarityScore     Float
  matchReason         String?
  status              String   @default("SUGGESTED") // SUGGESTED|CONFIRMED|REJECTED
  reviewedByOfficerId String?
  reviewedByOfficer   Officer? @relation("entityMatchReviewer", fields: [reviewedByOfficerId], references: [id], onDelete: Restrict)
  reviewedAt          DateTime?
  createdAt           DateTime @default(now())

  @@unique([entityAId, entityBId])
  @@index([status])
}

// Versioned by design: reprocessing creates a NEW row (spec §29);
// the latest row per (documentId, summaryType) is the current one.
model AIDocumentSummary {
  id               String   @id @default(cuid())
  documentId       String?  // null for CASE_CONTEXT case-level summaries (spec §16)
  document         CaseDocument? @relation("documentAiSummary", fields: [documentId], references: [id], onDelete: Restrict)
  caseRef          String
  summaryType      String   // SHORT | DETAILED | EXECUTIVE | CASE_CONTEXT
  summaryText      String
  sourceReferences String?  // JSON [{documentRef, pageNumber, section, quote}]
  modelProvider    String
  modelName        String
  modelVersion     String?
  jobId            String?
  reviewStatus     String   @default("PENDING")
  createdAt        DateTime @default(now())

  @@index([documentId, summaryType])
  @@index([reviewStatus])
}

// AI timeline SUGGESTIONS (spec §17/§71) — never official case events.
model AITimelineEvent {
  id              String    @id @default(cuid())
  caseId          String
  case            Case      @relation("caseAiTimeline", fields: [caseId], references: [id], onDelete: Restrict)
  caseRef         String    // public CASE id
  documentId      String?
  document        CaseDocument? @relation("documentAiTimeline", fields: [documentId], references: [id], onDelete: Restrict)
  documentRef     String?
  eventDate       DateTime?
  eventDateText   String?   // raw date text found in the source (honest when parse fails)
  eventTime       String?
  eventType       String    // AI_TIMELINE_EVENT_TYPES
  description     String
  sourceReference String?
  confidence      Float
  modelProvider   String
  modelName       String
  modelVersion    String?
  reviewStatus    String    @default("PENDING")
  jobId           String?
  createdAt       DateTime  @default(now())

  @@index([caseRef])
  @@index([eventType])
  @@index([reviewStatus])

  conflictsAsA AITimelineConflict[] @relation("conflictA")
  conflictsAsB AITimelineConflict[] @relation("conflictB")
}

// Surfaced contradiction (spec §18) — the AI never decides which
// date/fact is correct; only human review resolves (or dismisses).
model AITimelineConflict {
  id                  String    @id @default(cuid())
  caseRef             String
  eventAId            String
  eventA              AITimelineEvent @relation("conflictA", fields: [eventAId], references: [id], onDelete: Restrict)
  eventBId            String
  eventB              AITimelineEvent @relation("conflictB", fields: [eventBId], references: [id], onDelete: Restrict)
  conflictType        String    // DATE_MISMATCH | TIME_MISMATCH | FACT_MISMATCH
  description         String?
  status              String    @default("UNREVIEWED") // UNREVIEWED|RESOLVED|DISMISSED
  resolvedByOfficerId String?
  resolutionNote      String?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@unique([eventAId, eventBId])
  @@index([caseRef])
}

// Deterministic chunks (spec §19) — page-provenanced, never mixing
// unrelated documents; the unit of embedding and retrieval.
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   CaseDocument @relation("documentChunk", fields: [documentId], references: [id], onDelete: Restrict)
  caseRef    String
  pageNumber Int
  chunkIndex Int
  text       String
  tokenCount Int
  jobId      String?
  createdAt  DateTime @default(now())

  @@unique([documentId, pageNumber, chunkIndex])
  @@index([documentId])
  @@index([caseRef])

  embedding DocumentEmbedding? @relation("chunkEmbedding")
}

// Vector store (spec §21): SQLite MVP stores the vector as JSON;
// the production path is PostgreSQL + pgvector (documented, not
// claimed here — the project runs SQLite). Authorization metadata
// (caseRef/documentId) is denormalized onto every vector so search
// scope can be enforced server-side in the query itself (spec §22).
model DocumentEmbedding {
  id           String   @id @default(cuid())
  chunkId      String   @unique
  chunk        DocumentChunk @relation("chunkEmbedding", fields: [chunkId], references: [id], onDelete: Restrict)
  documentId   String
  document     CaseDocument @relation("documentEmbedding", fields: [documentId], references: [id], onDelete: Restrict)
  caseRef      String
  provider     String
  modelName    String
  modelVersion String?
  dimension    Int
  vectorJson   String   // JSON number array (pgvector replacement — MVP store)
  jobId        String?
  createdAt    DateTime @default(now())

  @@index([documentId])
  @@index([caseRef])
  @@index([provider, modelName])
}

// AI relationship SUGGESTION (spec §32) — Phase 6 will consume only
// HUMAN-CONFIRMED relationships for the knowledge graph (spec §67).
model AIRelationshipSuggestion {
  id                 String    @id @default(cuid())
  caseRef            String
  sourceDocumentId   String
  sourceDocument     CaseDocument @relation("aiRelSource", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  sourceDocumentRef  String
  targetDocumentId   String
  targetDocument     CaseDocument @relation("aiRelTarget", fields: [targetDocumentId], references: [id], onDelete: Restrict)
  targetDocumentRef  String
  relationshipType   String    // a DOCUMENT_RELATIONSHIP_TYPES value — suggestion only
  confidence         Float
  reason             String?
  sourceReferences   String?   // JSON
  status             String    @default("SUGGESTED") // SUGGESTED|CONFIRMED|REJECTED
  reviewedByOfficerId String?
  reviewedByOfficer  Officer?  @relation("aiRelationshipReviewer", fields: [reviewedByOfficerId], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?
  jobId              String?
  createdAt          DateTime  @default(now())

  @@unique([sourceDocumentId, targetDocumentId, relationshipType])
  @@index([caseRef])
  @@index([status])
}

// Result lineage (spec §29): every regeneration records the version
// chain; old outputs stay available and are never overwritten.
model AIResultVersion {
  id               String   @id @default(cuid())
  resultType       String   // DOCUMENT_TEXT|CLASSIFICATION|SUMMARY|TIMELINE|EMBEDDING|ENTITIES
  sourceRef        String   // display reference (e.g. DOC id)
  sourceInternalId String   // internal id of the result container row
  versionNumber    Int
  modelProvider    String
  modelName        String
  modelVersion     String?
  inputReference   String?  // hash/reference of the inputs used
  outputReference  String?  // JSON snapshot of the superseded output
  createdAt        DateTime @default(now())

  @@unique([resultType, sourceInternalId, versionNumber])
  @@index([resultType, sourceInternalId])
}

// Human review record (spec §30). Reviewer identity is ALWAYS the
// authenticated session's officer — the client never supplies it.
model AIReview {
  id                   String   @id @default(cuid())
  resultType           String   // CLASSIFICATION|ENTITY|SUMMARY|TIMELINE|RELATIONSHIP|ENTITY_MATCH|TIMELINE_CONFLICT
  resultId             String   // internal id of the reviewed row
  resultRef            String   // display reference for the review queue
  reviewerOfficerId    String
  reviewerOfficer      Officer  @relation("aiReviewReviewer", fields: [reviewerOfficerId], references: [id], onDelete: Restrict)
  reviewerDepartmentId String
  reviewerDepartment   Department @relation("aiReviewDepartment", fields: [reviewerDepartmentId], references: [id], onDelete: Restrict)
  status               String   // VERIFIED|REJECTED|OVERRIDDEN (PENDING lives on the result row)
  comment              String?
  createdAt            DateTime @default(now())

  @@index([resultType, resultId])
  @@index([reviewerOfficerId])
  @@index([status])
}

// Model registry (spec §28) — every AI result records its provider/
// model/version; this table is the inspectable inventory of models.
model AIModelRegistry {
  id              String   @id @default(cuid())
  provider        String
  modelName       String
  modelVersion    String?
  task            String   // AI_MODEL_TASKS
  languageSupport String?  // JSON array, e.g. ["en","hi"]
  enabled         Boolean  @default(true)
  configuration   String?  // JSON (non-secret configuration only)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, modelName, task])
  @@index([task])
  @@index([enabled])
}

// Administrative AI configuration (spec §56). Singleton row; changes
// require AI_CONFIGURE permission and create an audit event.
model AIConfig {
  id                                String   @id @default("SINGLETON")
  aiEnabled                         Boolean  @default(true)
  localOnly                         Boolean  @default(true) // LOCAL_ONLY: no case content to external providers (spec §37)
  llmProvider                       String   @default("heuristic") // heuristic (local baseline) | zai (external, blocked while localOnly)
  ocrProvider                       String   @default("tesseract")
  embeddingProvider                 String   @default("local-hashing")
  maxContextChars                   Int      @default(12000)
  maxConcurrentJobs                 Int      @default(2)
  classificationConfidenceThreshold Float    @default(0.55)
  qaRetrievalThreshold              Float    @default(0.18)
  autoProcessOnCommit               Boolean  @default(true)
  allowedProviders                  String?  // JSON allowlist
  updatedAt                         DateTime @updatedAt
  updatedByOfficerId                String?
}

// ============================================================
// PHASE 8 — Inter-Department Integration (adapter architecture).
//
// The platform is a CENTRALIZED SECURE CASE/DOCUMENT LAYER. It does
// NOT replace CCTNS / ICJS / e-Forensics / e-Prosecution / e-Courts /
// e-Prisons — it exchanges authorized data with them through
// capability-declared adapters. NO real government API is assumed:
// every shipped provider is MOCK/SANDBOX-labeled until a verified
// government interface exists (spec §1/§71).
//
// RULES ENCODED HERE:
// - Central IDs stay authoritative; external systems are mapped via
//   External*Reference rows (spec §11-§13) — never replaced.
// - External data is staged → validated → conflict-checked →
//   human-approved before it touches central records (§15/§21/§22).
// - Credentials are secret-store REFERENCES, never plaintext (§7).
// - Custody fields are NEVER written by integration (§28/§29).
// - Environments are explicit: DEVELOPMENT/TEST/SANDBOX/PRODUCTION
//   with PRODUCTION requiring explicit confirmation (§8/§70).
// SQLite note: statuses are strings validated at the boundary via
// src/lib/integrations/constants.ts (no Prisma enums on SQLite).
// ============================================================

model IntegrationConnection {
  id                    String    @id @default(cuid())
  connectionId          String    @unique // public identity: CONN-MP-IND-2026-000001
  providerType          String    // INTEGRATION_PROVIDER_TYPES (CCTNS, E_FORENSICS, ...)
  providerMode          String    @default("MOCK") // MOCK | SANDBOX | REAL — UI MUST display this (§71)
  displayName           String
  environment           String    @default("SANDBOX") // DEVELOPMENT | TEST | SANDBOX | PRODUCTION
  status                String    @default("CONFIGURED") // CONFIGURED | CONNECTED | DISCONNECTED | ERROR | DISABLED

  // Non-secret endpoint reference only (mock://cctns or a config-key
  // pointing at the deployment's endpoint registry). NEVER a URL
  // embedding credentials.
  baseUrlReference      String?
  authenticationType    String    @default("NONE") // NONE | API_KEY | OAUTH2_CC | MTLS | SIGNED_REQUEST
  credentialRef         String?   // secret-store pointer (secret://...) — never secret material (§7)
  hasWebhookSecret      Boolean   @default(false)

  // Department scoping (§39): a Police connection is not usable by
  // Forensics unless the connection belongs to (or is GLOBAL and the
  // actor is SYSTEM_ADMIN).
  ownerDepartmentId     String
  ownerDepartment       Department @relation("integrationOwner", fields: [ownerDepartmentId], references: [id], onDelete: Restrict)
  scope                 String    @default("DEPARTMENT") // DEPARTMENT | GLOBAL
  allowedOperations     String    @default("read,test,import,export") // csv gate refined by capabilities

  capabilitiesSnapshot  String?   // JSON snapshot resolved from the provider at test/create time
  configJson            String?   // non-secret runtime config: timeouts, retries, mock scenario flags

  enabled               Boolean   @default(true)
  lastHealthCheckAt     DateTime?
  lastHealthStatus      String?
  lastHealthLatencyMs   Int?
  lastSuccessAt         DateTime?
  lastFailureAt         DateTime?
  lastErrorCategory     String?
  consecutiveFailures   Int       @default(0)

  createdByOfficerId    String
  createdByOfficer      Officer   @relation("integrationCreator", fields: [createdByOfficerId], references: [id], onDelete: Restrict)

  credential            IntegrationCredential?
  importJobs            IntegrationImportJob[]
  exportJobs            IntegrationExportJob[]
  syncSchedules         IntegrationSyncSchedule[]
  syncCursors           IntegrationSyncCursor[]
  callLogs              IntegrationCallLog[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([providerType, environment])
  @@index([ownerDepartmentId])
  @@index([status])
  @@index([enabled])
}

// Secret ABSTRACTION row: points into the encrypted secret store.
// The store (src/lib/integrations/credentials.ts) holds AES-256-GCM
// blobs outside the database; Vault/KMS adapters implement the same
// interface later without schema change (§7).
model IntegrationCredential {
  id              String   @id @default(cuid())
  connectionId    String   @unique
  connection      IntegrationConnection @relation(fields: [connectionId], references: [connectionId], onDelete: Restrict)
  secretReference String   // e.g. secret://integrations/CONN-.../v1
  keyFingerprint   String?  // non-secret display fingerprint (HMAC prefix) for rotation UX
  rotatedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Central Case stays authoritative (§11) — this is a LINK, not an ID swap.
model ExternalCaseReference {
  id                    String   @id @default(cuid())
  caseInternalId        String
  case                  Case     @relation(fields: [caseInternalId], references: [id], onDelete: Restrict)
  providerType          String
  externalSystem        String   // e.g. "CCTNS-SANDBOX-MOCK"
  externalCaseId        String   // e.g. CCTNS-CASE-892341 / MOCK-CASE-001
  externalCaseNumber    String?
  externalReferenceType String   @default("CASE") // CASE | FIR | PROCEEDING
  status                String   @default("ACTIVE") // ACTIVE | SUPERSEDED | INACTIVE
  sourceHash            String?  // hash of the external payload at import (provenance §14)
  schemaVersion         String?
  mappingVersion        Int?
  importedByOfficerId   String
  importJobId           String?
  importedAt            DateTime @default(now())
  lastSyncedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerType, externalSystem, externalCaseId])
  @@index([caseInternalId])
  @@index([providerType])
}

model ExternalDocumentReference {
  id                  String   @id @default(cuid())
  documentInternalId  String
  document            CaseDocument @relation(fields: [documentInternalId], references: [id], onDelete: Restrict)
  providerType        String
  externalSystem      String
  externalDocumentId  String
  externalReference   String?
  status              String   @default("ACTIVE")
  sourceHash          String?  // hash reported by the external system (§26)
  centralHash         String?  // SHA-256 computed by THIS platform over received bytes
  hashVerified        Boolean  @default(false) // true only when both present and equal
  importedByOfficerId String
  importJobId         String?
  importedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([providerType, externalSystem, externalDocumentId])
  @@index([documentInternalId])
}

model ExternalEvidenceReference {
  id                      String   @id @default(cuid())
  evidenceInternalId      String
  evidence                Evidence @relation(fields: [evidenceInternalId], references: [id], onDelete: Restrict)
  providerType            String
  externalSystem          String
  externalEvidenceId      String
  externalReference       String?
  status                  String   @default("ACTIVE")
  // Provenance (§27): history is NEVER fabricated. When the source
  // system cannot provide historical custody, this stays false and
  // the record says HISTORY_UNAVAILABLE.
  custodyHistoryAvailable Boolean  @default(false)
  sourceCustodian         String?
  sourceDepartment        String?
  sourceHash              String?
  importJobId             String?
  importedByOfficerId     String
  importedAt              DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([providerType, externalSystem, externalEvidenceId])
  @@index([evidenceInternalId])
}

model IntegrationImportJob {
  id                    String    @id @default(cuid())
  jobId                 String    @unique // IJP-MP-IND-2026-000001
  connectionId          String
  connection            IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  providerType          String
  importType            String    // CASE | DOCUMENT | EVIDENCE | CASE_BUNDLE
  requestedByOfficerId  String
  requestedByOfficer    Officer   @relation("integrationImporter", fields: [requestedByOfficerId], references: [id], onDelete: Restrict)
  status                String    @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | PARTIAL | FAILED | CANCELLED
  startedAt             DateTime?
  completedAt           DateTime?
  recordsReceived       Int       @default(0)
  recordsImported       Int       @default(0)
  recordsRejected       Int       @default(0)
  recordsConflicted     Int       @default(0)
  recordsSkipped        Int       @default(0) // duplicates linked, no-op imports
  errorSummary          String?
  schemaVersion         String?
  mappingVersion        Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  records               IntegrationImportRecord[]

  @@index([connectionId])
  @@index([status])
  @@index([providerType])
  @@index([createdAt])
}

model IntegrationExportJob {
  id                    String    @id @default(cuid())
  jobId                 String    @unique // IEX-MP-IND-2026-000001
  connectionId          String
  connection            IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  providerType          String
  exportType            String    // CASE_PACKAGE | DOCUMENT | EVIDENCE
  requestedByOfficerId  String
  requestedByOfficer    Officer   @relation("integrationExporter", fields: [requestedByOfficerId], references: [id], onDelete: Restrict)
  status                String    @default("QUEUED")
  recordsSelected       Int       @default(0)
  recordsExported       Int       @default(0)
  recordsFailed         Int       @default(0)
  // Encrypted package stored via the Phase 3 DocumentStorage
  // abstraction (no second storage architecture, §44).
  packageStorageKey     String?
  manifestHash          String?   // SHA-256 of integrity.json content
  startedAt             DateTime?
  completedAt           DateTime?
  errorSummary          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([connectionId])
  @@index([status])
}

// Staging record (§21): raw reference + normalized payload +
// validation/conflict/processing state. One malformed record never
// crashes the job (§20).
model IntegrationImportRecord {
  id                  String   @id @default(cuid())
  importJobId         String
  importJob           IntegrationImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  externalRecordId    String
  recordType          String   // CASE | DOCUMENT | EVIDENCE
  rawReference        String?  // external identity/reference — NOT raw payloads
  normalizedPayload   String?  // mapped+validated JSON (data minimization §64)
  validationStatus    String   @default("PENDING") // PENDING | VALID | INVALID | SCHEMA_UNSUPPORTED
  validationErrors    String?  // structured JSON errors
  conflictStatus      String   @default("NONE") // NONE | DETECTED | RESOLVED
  processingStatus    String   @default("PENDING") // PENDING | STAGED | APPROVED | IMPORTED | REJECTED | FAILED | SKIPPED_DUPLICATE
  errorDetails        String?
  centralRecordRef    String?  // central public id after import/link (CASE-… / DOC-… / EVD-…)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([importJobId])
  @@index([processingStatus])
  @@index([validationStatus])
}

model IntegrationConflict {
  id                    String    @id @default(cuid())
  conflictId            String    @unique // ICF-MP-IND-2026-000001
  importJobId           String?
  importRecordId        String?
  caseRef               String?   // public CASE-…
  documentRef           String?
  evidenceRef           String?
  providerType          String
  externalReference     String?
  fieldName             String
  centralValue          String?
  externalValue         String?
  centralSource         String    @default("CENTRAL_AUTHORITATIVE") // SOURCE_AUTHORITY values (§23)
  externalSource        String    @default("EXTERNAL_SOURCE")
  centralUpdatedAt      DateTime?
  externalUpdatedAt     DateTime?
  status                String    @default("OPEN") // OPEN | RESOLVED_CENTRAL | RESOLVED_EXTERNAL | MERGED | IGNORED
  resolvedByOfficerId   String?
  resolvedByOfficer     Officer?  @relation("integrationConflictResolver", fields: [resolvedByOfficerId], references: [id], onDelete: SetNull)
  resolvedAt            DateTime?
  resolutionNote        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([caseRef])
  @@index([providerType])
}

model IntegrationWebhookEvent {
  id                String    @id @default(cuid())
  providerType      String
  connectionId      String?
  externalEventId   String?
  eventType         String
  receivedAt        DateTime  @default(now())
  signatureStatus   String    @default("PENDING") // VERIFIED | INVALID | MISSING | DISABLED
  processingStatus  String    @default("RECEIVED") // RECEIVED | VALIDATED | PROCESSED | REJECTED | FAILED
  payloadHash       String?   // sha256 of raw body — audit-safe reference, never the payload
  processedAt       DateTime?
  errorMessage      String?
  idempotencyKey    String    // provider event id, or deterministic hash when absent (§32)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([providerType, idempotencyKey])
  @@index([processingStatus])
  @@index([receivedAt])
}

model IntegrationSyncSchedule {
  id               String   @id @default(cuid())
  connectionId     String
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  providerType     String
  syncType         String   @default("POLLING") // POLLING | WEBHOOK_ASSISTED
  frequencyMinutes Int      @default(60) // clamped to provider limits (§33)
  enabled          Boolean  @default(true)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([connectionId])
  @@index([enabled])
}

model IntegrationSyncCursor {
  id                  String    @id @default(cuid())
  connectionId        String
  connection          IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  providerType        String
  resourceType        String    // CASE | DOCUMENT | EVIDENCE
  cursorValue         String?   // updated_since / page token — never re-download everything (§34)
  lastSuccessfulSync  DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([connectionId, resourceType])
}

model IntegrationSchemaVersion {
  id                String   @id @default(cuid())
  providerType      String
  schemaName        String   @default("case_exchange")
  schemaVersion     String   // e.g. 1.0
  supported         Boolean  @default(true)
  minMappingVersion Int      @default(1)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerType, schemaName, schemaVersion])
}

model IntegrationMappingVersion {
  id             String   @id @default(cuid())
  providerType   String
  mappingName    String   // case_import | document_import | evidence_import
  mappingVersion Int
  mappingJson    String   // FieldMapping[] — mappings are DATA, not code (§18)
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([providerType, mappingName, mappingVersion])
}

// Operational metrics (§66) — references and counters only, NEVER
// payload contents.
model IntegrationCallLog {
  id            String   @id @default(cuid())
  connectionId  String
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  providerType  String
  operation     String
  outcome       String   // SUCCESS | FAILURE
  latencyMs     Int?
  errorCategory String?  // TIMEOUT | NETWORK | RATE_LIMITED | SERVER_ERROR | AUTH_FAILED | ...
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([connectionId, createdAt])
  @@index([outcome])
}

// ============================================================
// PHASE 6 — Case knowledge graph (spec §67/§68).
//
// A DERIVED, REBUILDABLE PROJECTION of the central records — never
// authoritative, never a source of truth. The graph is stored in
// Prisma/SQLite (MVP simulation); NO Neo4j/graph-database claim is
// made. Everything in the graph traces to a central row via
// GraphEdge.sourceRefs, and every edge is grounded in one of:
//   - STRUCTURAL containment (case→document/evidence/department)
//   - HUMAN-created relationships (Phase 3/4 relationship tables)
//   - HUMAN-CONFIRMED AI relationship suggestions (Phase 5, spec §67)
//   - VERIFIED entities + CONFIRMED entity matches (Phase 5)
// AI SUGGESTED/REJECTED data NEVER enters the graph (spec §67).
//
// Sync is a deterministic full rebuild per case inside one
// transaction; classification levels are projected onto nodes so
// READ-time clearance filtering can drop sensitive subgraphs without
// ever touching central data.
// ============================================================
model GraphSyncState {
  id                   String   @id @default(cuid())
  caseRef              String   @unique // public CASE id (CASE-…)
  case                 Case     @relation("caseGraphSync", fields: [caseRef], references: [caseId], onDelete: Restrict)
  status               String   @default("SYNCED") // GRAPH_SYNC_STATUSES
  nodeCount            Int      @default(0)
  edgeCount            Int      @default(0)
  syncVersion          Int      @default(1)
  lastSyncedAt         DateTime @default(now())
  lastError            String?
  triggeredByOfficerId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

model GraphNode {
  id             String  @id @default(cuid())
  caseRef        String  // public CASE id
  nodeKey        String  // stable within the case: CASE:<id> | DOC:<id> | EVD:<id> | ENT:<TYPE>:<slug> | DEPT:<code>
  nodeType       String  // GRAPH_NODE_TYPES
  label          String
  refId          String? // public identity of the underlying record where one exists
  entityType     String? // AI_ENTITY_TYPES value for ENTITY nodes
  classification String? // max classification of supporting records (drives read-time clearance filtering)
  status         String? // underlying record status snapshot (COMMITTED/SUPERSEDED/…)
  provenance     String? // JSON [{model,id}] — contributing central rows, full traceability

  @@unique([caseRef, nodeKey])
  @@index([caseRef])
  @@index([nodeType])
}

model GraphEdge {
  id                   String   @id @default(cuid())
  caseRef              String   // public CASE id
  edgeKey              String   // deterministic: source>TYPE(:rel)#prov>target
  sourceKey            String
  targetKey            String
  edgeType             String   // GRAPH_EDGE_TYPES
  relationshipType     String?  // original registry value (SUPPLEMENTS/DESCRIBES/…)
  provenance           String   // GRAPH_EDGE_PROVENANCE
  sourceRefs           String?  // JSON [{model,id}] — traceability to central rows
  confirmedByOfficerId String?  // officerId when a human created/confirmed the underlying relationship
  confidence           Float?   // ONLY on AI-confirmed edges — human/structural facts carry null
  createdAt            DateTime @default(now())

  @@unique([caseRef, edgeKey])
  @@index([caseRef])
  @@index([sourceKey])
  @@index([targetKey])
}

// ============================================================
// Phase 9 — Manual Import/Export + Interoperability Fallback.
// Manual packages are the FALLBACK interoperability channel for
// situations where no API integration exists (Phase 8 remains
// the primary interop mechanism; a manual package is NEVER a
// live system integration). Additive models, string statuses
// (SQLite), Restrict FKs — same conventions as Phases 3-8.
// ============================================================

model PackageRecord {
  id                  String   @id @default(cuid())
  packageId           String   @unique // PKG-MP-IND-2026-NNNNNN — immutable, never reused
  packageType         String   // PACKAGE_TYPES: *_EXPORT / *_IMPORT variants
  schemaVersion       String   // e.g. "1.0" — importer refuses unknown versions
  sourceSystem        String   // declared, never fabricated by the platform
  sourceDepartment    String?
  sourceApplication   String?
  sourceVersion       String?
  createdInEnvironment String? // source_environment (declared by creator)
  classification      String   // >= most restrictive included record (§48)
  caseCount           Int      @default(0)
  documentCount       Int      @default(0)
  evidenceCount       Int      @default(0)
  relationshipCount   Int      @default(0)
  integrityAlgorithm  String   @default("SHA-256")
  // Deterministic canonical-manifest integrity value (§14) — NOT a signature.
  packageIntegrity    String
  // Raw archive bytes SHA-256 — the duplicate-detection hash (§43/§70).
  packageSha256       String   @unique
  manifestHash        String
  firstSeenJobId      String?  // manual export/import job that introduced it
  createdAt           DateTime @default(now())

  files        PackageFile[]
  integrityChecks PackageIntegrityRecord[]
  signatures   PackageSignature[]
  downloads    PackageDownload[]

  @@index([packageSha256])
  @@index([packageType])
}

model PackageFile {
  id         String @id @default(cuid())
  packageId  String
  package    PackageRecord @relation(fields: [packageId], references: [id], onDelete: Restrict)
  path       String // package-relative, normalized
  sha256     String
  size       Int

  @@unique([packageId, path])
  @@index([packageId])
}

model PackageIntegrityRecord {
  id            String   @id @default(cuid())
  packageId     String
  package       PackageRecord @relation(fields: [packageId], references: [id], onDelete: Restrict)
  jobId         String?  // manual export/import job that ran the check
  kind          String   // EXPORT_BUILD | IMPORT_VERIFY
  algorithm     String   @default("SHA-256")
  result        String   // MATCH | MISMATCH | FAILED
  expectedSha256 String?
  actualSha256  String?
  verifiedByOfficerId String?
  verifiedAt    DateTime @default(now())

  @@index([packageId])
  @@index([jobId])
}

model PackageSignature {
  id          String   @id @default(cuid())
  packageId   String
  package     PackageRecord @relation(fields: [packageId], references: [id], onDelete: Restrict)
  algorithm   String   @default("UNSUPPORTED") // future: RSA | ECDSA | Ed25519
  status      String   @default("UNSUPPORTED") // UNSIGNED | UNSUPPORTED | VALID | INVALID
  note        String?
  createdAt   DateTime @default(now())

  @@index([packageId])
}

model PackageDownload {
  id                  String   @id @default(cuid())
  packageId           String
  package             PackageRecord @relation(fields: [packageId], references: [id], onDelete: Restrict)
  exportJobId         String?  // manual export job the download came from
  downloadedByOfficerId String
  downloadedByDepartmentId String
  downloadedAt        DateTime @default(now())

  @@index([packageId])
  @@index([exportJobId])
}

model ManualExportJob {
  id                        String    @id @default(cuid())
  jobId                     String    @unique // MEX-MP-IND-2026-NNNNNN
  packageId                 String?   // assigned when the package is built
  requestedByOfficerId      String
  requestedByOfficer        Officer   @relation("manualExporter", fields: [requestedByOfficerId], references: [id], onDelete: Restrict)
  requestedByDepartmentId   String
  requestedByDepartment     Department @relation("manualExportDepartment", fields: [requestedByDepartmentId], references: [id], onDelete: Restrict)
  exportType                String    // PACKAGE_TYPES *_EXPORT values
  status                    String    @default("QUEUED") // EXPORT_JOB_STATUSES
  selection                 String?   // JSON: caseRef, documentIds, evidenceIds, includes, purpose
  recordCounts              String?   // JSON {cases, documents, evidence, relationships, auditEvents, excluded}
  classification            String?   // package classification (max of included records)
  startedAt                 DateTime?
  completedAt               DateTime?
  packageStorageKey         String?   // opaque interop-packages/... key (encrypted at rest)
  packageKeyReference       String?   // encryption key version reference — never key material
  packageSize               Int?
  packageSha256             String?   // raw archive hash (dup detection + integrity)
  expiresAt                 DateTime?
  errorCode                 String?
  errorMessage              String?
  createdAt                 DateTime  @default(now())

  @@index([requestedByOfficerId])
  @@index([requestedByDepartmentId])
  @@index([status])
  @@index([packageId])
}

model ManualImportJob {
  id                        String    @id @default(cuid())
  jobId                     String    @unique // MIM-MP-IND-2026-NNNNNN
  packageId                 String?
  uploadedByOfficerId       String
  uploadedByOfficer         Officer   @relation("manualImporter", fields: [uploadedByOfficerId], references: [id], onDelete: Restrict)
  uploadedByDepartmentId    String
  uploadedByDepartment      Department @relation("manualImportDepartment", fields: [uploadedByDepartmentId], references: [id], onDelete: Restrict)
  status                    String    @default("UPLOADED") // IMPORT_JOB_STATUSES
  packageType               String?
  schemaVersion             String?
  sourceSystem              String?   // from manifest — declared, never fabricated
  sourceDepartment          String?
  packageTypeClassification String?   // package classification from manifest
  stage                     String?   // current pipeline stage for progress (§79)
  packageStorageKey         String?   // staged archive (encrypted at rest)
  packageKeyReference       String?
  packageSize               Int?
  packageSha256             String?
  manifestHash              String?
  integrityResult           String?   // MATCH | MISMATCH | FAILED | PENDING
  signatureStatus           String?   // UNSIGNED | UNSUPPORTED | VALID | INVALID
  scanStatus                String?   // CLEAN | SUSPICIOUS | MALICIOUS | PENDING | SKIPPED
  recordsReceived           Int       @default(0)
  recordsValid              Int       @default(0)
  recordsInvalid            Int       @default(0)
  recordsConflicted         Int       @default(0)
  recordsImported           Int       @default(0)
  requiresApproval          Boolean   @default(false)
  errorCode                 String?
  errorMessage              String?
  errorSummary              String?
  startedAt                 DateTime?
  completedAt               DateTime?
  createdAt                 DateTime  @default(now())

  records   ManualImportRecord[]
  approvals ImportApproval[]
  conflicts ManualImportConflict[] @relation("manualConflictJob")

  @@index([uploadedByOfficerId])
  @@index([uploadedByDepartmentId])
  @@index([status])
}

model ManualImportRecord {
  id                   String @id @default(cuid())
  importJobId          String
  importJob            ManualImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  recordType           String // CASE | DOCUMENT | EVIDENCE | RELATIONSHIP
  externalId           String // id as declared inside the package
  resolution           String? // CREATE | LINK_EXISTING | UPDATE_ALLOWED_FIELD | CONFLICT | REJECT
  targetEntityId       String? // central public id when linked/created
  payloadJson          String? // sanitized metadata payload (no binaries)
  payloadPath          String? // package-relative path of the binary (documents/evidence)
  binarySha256         String? // declared/observed binary hash
  validationStatus     String  @default("PENDING") // PENDING | VALID | INVALID
  conflictStatus       String  @default("NONE") // NONE | CONFLICT
  authorizationStatus  String  @default("PENDING") // PENDING | AUTHORIZED | UNAUTHORIZED
  processingStatus     String  @default("PENDING") // PENDING | STAGED | IMPORTED | REJECTED | SKIPPED_DUPLICATE
  errorDetails         String?
  createdAt            DateTime @default(now())

  @@index([importJobId])
  @@index([recordType])
  @@index([externalId])
}

model ManualImportConflict {
  id              String   @id @default(cuid())
  conflictId      String   @unique // MCF-MP-IND-2026-NNNNNN
  importJobId     String
  importJob       ManualImportJob @relation("manualConflictJob", fields: [importJobId], references: [id], onDelete: Restrict)
  recordType      String
  recordRecordId  String?  // ManualImportRecord.externalId of the subject record
  fieldName       String
  centralValue    String?
  incomingValue   String?
  sourceReference String?  // package path / external reference the incoming value came from
  conflictType    String   // FIELD_VALUE | CLASSIFICATION_POLICY | IMMUTABLE_FIELD | DUPLICATE_BINARY
  status          String   @default("OPEN") // OPEN | ACCEPT_INCOMING | KEEP_CENTRAL | MERGE | REJECT_RECORD
  resolvedByOfficerId String?
  resolvedByOfficer   Officer? @relation("manualConflictResolver", fields: [resolvedByOfficerId], references: [id], onDelete: Restrict)
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime @default(now())

  @@index([importJobId])
  @@index([status])
  @@index([recordType])
}

model ImportApproval {
  id                    String   @id @default(cuid())
  importJobId           String
  importJob             ManualImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  reviewerOfficerId     String
  reviewerOfficer       Officer  @relation("importApprover", fields: [reviewerOfficerId], references: [id], onDelete: Restrict)
  reviewerDepartmentId  String
  decision              String   // APPROVED | REJECTED | PARTIALLY_APPROVED
  comment               String?
  createdAt             DateTime @default(now())

  @@index([importJobId])
  @@index([reviewerOfficerId])
}
